{
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "main": "web/.open-next/worker.js",
  "name": "terrapos-web",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "npm --prefix web ci && npm --prefix web install --no-save --package-lock=false @opennextjs/cloudflare@latest && cd web && npx -y @opennextjs/cloudflare@latest build"
  },
  "assets": {
    "directory": "web/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "terrapos-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
