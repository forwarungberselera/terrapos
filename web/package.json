{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:apk": "NEXT_OUTPUT=export next build && npx cap sync android",
    "deploy:pages": "wrangler pages deploy out --project-name terrapos-web --branch main",
    "build:workers": "npx -y @opennextjs/cloudflare@latest build",
    "preview:workers": "npm run build:workers && npx -y @opennextjs/cloudflare@latest preview",
    "deploy:workers": "npm run build:workers && npx -y @opennextjs/cloudflare@latest deploy",
    "upload:workers": "npm run build:workers && npx -y @opennextjs/cloudflare@latest upload",
    "cf-typegen": "npx -y wrangler@latest types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "firebase": "^12.9.0",
    "next": "16.1.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
